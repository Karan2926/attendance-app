# Frontend environment
# In dev, Vite proxies /api to http://127.0.0.1:8000 by default.
# Override the proxy target if your Django backend is elsewhere:
VITE_API_PROXY=http://127.0.0.1:8000

# In production builds served separately from the API, set the full API origin.
# Leave empty when nginx routes /api to Django on the same origin.
# VITE_API_BASE=http://localhost:8000
