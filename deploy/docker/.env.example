# docker-compose environment — copy to deploy/docker/.env

# --- Database ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Django ---
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,<SERVER_IP>
DJANGO_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
DJANGO_DATABASE_URL=postgresql://attendance:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/attendance

# --- App behaviour ---
KEEP_CAPTURE_IMAGES=0
MAX_CAPTURE_IMAGES=48
MAX_CONTENT_LENGTH_MB=20
ALLOW_PUBLIC_REGISTER=0
REGISTER_INVITE_CODE=

# --- Portal sync (leave empty unless you have a SaaS portal) ---
PORTAL_API_KEY=
PORTAL_PUSH_URL=
PORTAL_PUSH_TOKEN=

# --- Frontend / nginx ---
# Host port nginx binds to. 80 requires root (fine for docker). Use 8080 if 80 is taken.
HTTP_PORT=80
