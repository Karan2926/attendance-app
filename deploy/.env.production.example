# ------------------------------------------------------------------
# Attendance app — production environment for the Django backend
# Copy to the server as:  /opt/attendance-app/backend/.env
# ------------------------------------------------------------------

# --- Core Django ---
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,<SERVER_IP>

# --- Database (PostgreSQL on the same server) ---
DJANGO_DATABASE_URL=postgresql://attendance:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5433/attendance
USE_SQLITE=0

# --- Security ---
DJANGO_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_HTTPONLY=1
# Enforce HTTPS + HSTS for 1 year (requires the nginx proxy header — already set)
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
# Content-Security-Policy (blocks XSS). Turn ON only when serving the built
# frontend from the same origin (stay OFF with the Vite dev server).
CSP_ENABLED=1

# --- Face recognition storage ---
# Point these at a dedicated, backed-up location (e.g. an attached volume).
DATASET_DIR=/var/lib/attendance/dataset
MODEL_PATH=/var/lib/attendance/model.pkl
TRAIN_STATUS_FILE=/var/lib/attendance/train_status.json

# --- App behaviour ---
KEEP_CAPTURE_IMAGES=0
MAX_CAPTURE_IMAGES=48
MAX_CONTENT_LENGTH_MB=20

# --- Image upload hardening ---
# Per-file size limit, max pixels and max side-length of uploaded images.
# Files that fail magic-byte / size / dimension checks are rejected before
# they reach the face pipeline or disk.
MAX_IMAGE_UPLOAD_MB=10
MAX_IMAGE_PIXELS=30000000
MAX_IMAGE_SIDE=9000
# Django request-body cap (bytes) — mirrors the nginx client_max_body_size.
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400

ALLOW_PUBLIC_REGISTER=0
REGISTER_INVITE_CODE=

# --- Portal sync (leave empty unless you have a SaaS portal) ---
PORTAL_API_KEY=
PORTAL_PUSH_URL=
PORTAL_PUSH_TOKEN=
