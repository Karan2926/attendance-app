# ------------------------------------------------------------------
# Attendance app — production environment for the Django backend
# Copy to the server as:  /opt/attendance-app/backend/.env
# ------------------------------------------------------------------

# --- Core Django ---
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,<SERVER_IP>

# --- Database (PostgreSQL on the same server) ---
DJANGO_DATABASE_URL=postgresql://attendance:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5433/attendance
USE_SQLITE=0

# --- Security ---
DJANGO_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax

# --- Face recognition storage ---
# Point these at a dedicated, backed-up location (e.g. an attached volume).
DATASET_DIR=/var/lib/attendance/dataset
MODEL_PATH=/var/lib/attendance/model.pkl
TRAIN_STATUS_FILE=/var/lib/attendance/train_status.json

# --- App behaviour ---
KEEP_CAPTURE_IMAGES=0
MAX_CAPTURE_IMAGES=48
MAX_CONTENT_LENGTH_MB=20
ALLOW_PUBLIC_REGISTER=0
REGISTER_INVITE_CODE=

# --- Portal sync (leave empty unless you have a SaaS portal) ---
PORTAL_API_KEY=
PORTAL_PUSH_URL=
PORTAL_PUSH_TOKEN=
